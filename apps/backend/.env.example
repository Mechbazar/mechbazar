# Copy this file to .env and fill in real values.
# Required -- the server refuses to start without these (see src/config/env.ts).

# Port the backend listens on. 5001 is the project default; every frontend
# (apps/mobile, apps/admin, apps/vendor) falls back to this same port in dev.
PORT=5001

# Postgres connection string (Prisma). In production this points at the
# Hostinger PostgreSQL instance -- every app uses this same DATABASE_URL.
# IMPORTANT (production/Docker only): the backend runs inside a container,
# but Postgres runs natively on the VPS host -- `localhost`/`127.0.0.1` from
# inside the container means the container itself, not the host, so this
# will fail to connect. Use `host.docker.internal` instead (docker-compose.yml
# maps it to the host gateway via extra_hosts). Local (non-Docker) dev should
# keep using 127.0.0.1 as shown here.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/mechbazar?schema=public"

# Signs auth JWTs. There is NO fallback in code -- src/utils/jwt.ts throws if
# this is unset, and src/config/env.ts refuses to boot in production if it is
# one of the known placeholder values below, or warns if it is under 32 chars.
# A forged JWT authenticates as any role including SUPER_ADMIN, so treat this
# as the single most sensitive value in the file.
#
# Generate a real one:   openssl rand -base64 48
#
# The value below is a LOCAL DEVELOPMENT PLACEHOLDER and is rejected in
# production. Never reuse it anywhere real.
JWT_SECRET="dev-only-placeholder-change-me-before-any-deploy"

# Optional -- caching only. The server logs a warning and keeps running
# without Redis if this is unset or unreachable.
REDIS_URL="redis://127.0.0.1:6379"

# Required -- Firebase Admin SDK credentials. Phone auth (customer app) AND
# Admin/Vendor email+password auth are both Firebase-only: every app runs the
# relevant Firebase Auth client-side and sends the resulting ID token to the
# login/register endpoints, which the backend verifies with these credentials
# (src/utils/otp.ts for phone, src/utils/firebaseAuth.ts for admin/vendor
# email login). The server refuses to boot without all three (src/config/env.ts).
# There is no TEST mode, no local OTP generation, and no dev bypass. Get these
# from Firebase Console -> Project Settings -> Service accounts -> Generate
# new private key. Keep FIREBASE_PRIVATE_KEY's literal \n sequences intact
# (the code converts them to real newlines at runtime).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional -- only used by `npm run seed:admin` (prisma/seed-admin.ts) to
# create/update the local dev admin account's Firebase password. No hardcoded
# fallback -- the script fails without it. Never commit a real value.
SEED_ADMIN_EMAIL=admin@mechbazar.com
SEED_ADMIN_PASSWORD=

# Optional -- when set, POST /upload (upload.controller.ts) saves files to
# this Firebase Storage bucket instead of the local uploads/ dir. Uses the
# same firebase-admin credentials above.
# Example: mech-bazar-8fd86.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# REQUIRED for password reset. Without it POST /auth/forgot-password answers
# 503 and says resets are unavailable, and the login paths cannot reconcile a
# password that was changed on Firebase's side.
#
# Must be a key with NO application restriction. The project's Browser key
# (the one apps/admin and apps/mobile ship) is referrer-restricted and Google
# rejects it from a server with "Requests from referer <empty> are blocked" --
# do not use it, and do not reuse the Android/iOS keys, which ship inside the
# apps and cannot be rotated without a release. Create a dedicated one:
#
#   gcloud services api-keys create --project=mech-bazar-8fd86 \
#     --display-name="Identity Toolkit (backend)" \
#     --api-target=service=identitytoolkit.googleapis.com
#   gcloud services api-keys get-key-string <UID> --project=mech-bazar-8fd86
#
# See apps/backend/src/utils/firebasePassword.ts for the full rationale.
FIREBASE_WEB_API_KEY=

# Optional -- deadline for the Identity Toolkit REST calls above. Default 8000.
FIREBASE_REST_TIMEOUT_MS=

# Comma-separated allowlist of browser origins for CORS. Unset means ANY
# website's JavaScript can call this API and read authenticated responses --
# fine locally, not acceptable in production, where the server logs a
# [SECURITY] error at boot if this is empty. REQUIRED in production.
# Example:
# CORS_ALLOWED_ORIGINS=https://mechbazar.com,https://admin.mechbazar.com,https://vendor.mechbazar.com
CORS_ALLOWED_ORIGINS=

# Optional -- server-side Google Maps Platform key (Geocoding API + Places API
# enabled), used by src/services/geocoding.service.ts and exposed to every
# frontend via /api/geocode/*. This is a DIFFERENT key from apps/mobile's
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY -- that one is embedded in a public client
# bundle and must be HTTP-referrer/package-restricted; this one never leaves
# the server and should be restricted by server IP (or left
# application-unrestricted) and scoped to only Geocoding API + Places API in
# Google Cloud Console. If unset, geocoding.service.ts's MAPS_ENABLED flag is
# false and every function returns a graceful "unavailable" result instead of
# throwing -- the backend boots and runs normally without it.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional -- timeout (ms) for outbound Google Maps API calls before the
# service gives up and returns an "unavailable" result. Default 5000 if unset.
GOOGLE_MAPS_TIMEOUT_MS=5000

NODE_ENV=development
