generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  OPERATIONS_MANAGER
  INVENTORY_MANAGER
  VENDOR_MANAGER
  FINANCE_MANAGER
  CUSTOMER_SUPPORT
  VENDOR
  DELIVERY_PARTNER
  SERVICE_TECHNICIAN
}

enum VendorStatus {
  PENDING
  UNDER_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum RiderStatus {
  PENDING
  UNDER_VERIFICATION
  RESUBMISSION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PACKING
  PICKUP
  ON_THE_WAY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  RAZORPAY
  // Legacy value only: rows written before the COD-only lock (see
  // services/payment.service.ts) could carry this. Never written by current
  // code -- kept solely so existing production rows survive the column's
  // conversion from free text to this enum.
  ONLINE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TechnicianStatus {
  PENDING
  UNDER_VERIFICATION
  RESUBMISSION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  BLOCKED
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  // Emergency dispatch is in flight: offers have been fanned out to nearby
  // mechanics and we are waiting for the first accept. Distinct from
  // MECHANIC_ASSIGNED, which means exactly one mechanic already owns the job
  // (admin manual assignment, or the legacy scheduled-booking auto-assign).
  SEARCHING
  MECHANIC_ASSIGNED
  MECHANIC_ACCEPTED
  MECHANIC_ON_THE_WAY
  ARRIVED
  WORK_STARTED
  COMPLETED
  CANCELLED
  REJECTED
  // Every dispatch wave expired with no acceptance. Terminal for the dispatch
  // engine but NOT for the booking -- an admin can still assign manually, and
  // the customer can retry or cancel, so it is deliberately not lumped in with
  // CANCELLED.
  NO_MECHANIC_FOUND
}

// Lifecycle of a single offer made to a single mechanic during dispatch.
// Exactly one offer per job may reach ACCEPTED -- enforced by the conditional
// UPDATE in dispatch.service.ts (see acceptDispatchOffer), not by a DB
// constraint, because "at most one row with status=ACCEPTED per bookingId" is
// not expressible as a Postgres unique index over a mutable column.
enum DispatchOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  // Another mechanic won the race; this offer was closed by the system rather
  // than by the mechanic it was shown to.
  SUPERSEDED
  CANCELLED
}

enum JobOtpPurpose {
  START
  COMPLETION
}

enum AccountType {
  RETAIL
  WHOLESALE
  BOTH
}

enum VehicleType {
  CAR
  BIKE
}

// Shared by VendorDocument, RiderDocument, and TechnicianDocument -- all three
// KYC-upload verification workflows go through the same admin review states.
enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Shared by VendorSettlement, RiderSettlement, and TechnicianSettlement -- the
// three payout ledgers all move through the same admin-driven states.
enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Shared by Coupon and Offer.
enum DiscountType {
  PERCENTAGE
  FLAT
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerType {
  HOMEPAGE
  CATEGORY
  PROMO
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StockMovementAction {
  PURCHASE
  SALE
  RETURN
  DAMAGE
  ADJUSTMENT
  TRANSFER
}

enum StockTransferStatus {
  PENDING
  APPROVED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
  COMPLETED
  CANCELLED
}

model User {
  id          String  @id @default(uuid())
  phone       String  @unique
  email       String? @unique
  name        String?
  password    String?
  firebaseUid String? @unique
  // Legacy single-role column -- kept for existing admin listings/back-compat.
  // Reflects the FIRST role ever assigned to this identity, never updated
  // again once a second role is attached. `roles` below is the authoritative
  // set of roles this phone/identity actually holds; every authorization
  // check that needs to know "can this identity act as X" reads `roles`, not
  // this column. See the platform's single-identity design: one User row per
  // phone, one Firebase user per phone, any number of role profiles
  // (vendorProfile/deliveryProfile/technicianProfile) attached to it.
  role        Role    @default(CUSTOMER)
  // Every role this identity currently holds. CUSTOMER is implicit for every
  // account (shopping/booking is never gated by role), so it's the default
  // for brand-new rows. Registering as Vendor/Rider/Mechanic on a phone that
  // already has a User row appends to this array instead of creating a
  // second identity -- see controllers/{vendor,rider,technician}.controller.ts.
  roles       Role[]  @default([CUSTOMER])

  // B2B & Mode Fields
  accountType        AccountType @default(RETAIL)
  companyName        String?
  contactPerson      String?
  gstNumber          String?
  businessType       String?
  city               String?
  state              String?
  isBusinessVerified Boolean     @default(false)

  avatar        String?
  gender        String?
  dob           String?
  wallet        Float    @default(0.0)
  expoPushToken String?
  fcmToken      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Self-service account deletion (Google Play "Data deletion" requirement and
  // Apple Guideline 5.1.1(v)). Deletion is an anonymise-in-place, not a row
  // delete: Order/ServiceBooking/Payment rows are statutory records (Companies
  // Act s.128, CGST Act s.36 -- 8 years) and several of them FK back to this
  // row, so the row survives with every piece of personal data stripped.
  // `phone` is rewritten to a non-dialable sentinel so the unique constraint is
  // freed and the number can never log in or be matched again.
  deletedAt      DateTime?
  deletionReason String?

  addresses         Address[]
  userVehicles      UserVehicle[]
  orders            Order[]
  reviews           Review[]
  wishlists         Wishlist[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  stockMovements    StockMovement[]
  vendorProfile     Vendor?
  deliveryProfile   DeliveryPartner?
  technicianProfile ServiceTechnician?
  serviceBookings   ServiceBooking[]
  serviceReviews    ServiceReview[]
}

model Vendor {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  storeName     String
  gstNumber     String?
  panNumber     String?
  businessType  String?
  categories    String[]
  walletBalance Float        @default(0.0)
  status        VendorStatus @default(PENDING)
  isActive      Boolean      @default(true)

  // Store address -- previously nonexistent; "location" was written onto the
  // related User's city/state instead (see vendor.controller.ts, which keeps
  // doing that for backward compat). All nullable/additive.
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  pincode          String?
  country          String?
  lat              Float?
  lng              Float?
  placeId          String?
  formattedAddress String?

  products     Product[]
  documents    VendorDocument[]
  bankAccounts VendorBankAccount[]
  settlements  VendorSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model VendorDocument {
  id         String                     @id @default(uuid())
  vendorId   String
  vendor     Vendor                     @relation(fields: [vendorId], references: [id])
  type       String // GST, PAN, AADHAAR, SHOP_PHOTO, OWNER_PHOTO, BUSINESS_LICENSE, CANCELLED_CHEQUE
  url        String
  status     DocumentVerificationStatus @default(PENDING)
  uploadedAt DateTime                   @default(now())
}

model VendorBankAccount {
  id                String   @id @default(uuid())
  vendorId          String
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VendorSettlement {
  id            String           @id @default(uuid())
  vendorId      String
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  amount        Float
  status        SettlementStatus @default(PENDING)
  transactionId String?
  date          DateTime         @default(now())
}

model DeliveryPartner {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  vehicleType   String
  licenseNumber String
  isActive      Boolean @default(false)
  isOnline      Boolean @default(false)
  currentLat    Float?
  currentLng    Float?
  expoPushToken String?
  walletBalance Float   @default(0.0)

  // KYC / registration & verification (app self-registration path; admin
  // quick-created riders default straight to APPROVED, see createRider)
  status                    RiderStatus @default(PENDING)
  addressLine               String?
  city                      String?
  state                     String?
  pincode                   String?
  // Geocoded KYC address -- additive alongside the free-text fields above
  // (which stay untouched: renaming/splitting addressLine would break
  // currently-deployed rider app builds). currentLat/currentLng above are the
  // live GPS ping and are a separate concept from this.
  lat                       Float?
  lng                       Float?
  placeId                   String?
  formattedAddress          String?
  country                   String?
  aadhaarNumber             String?
  vehicleModel              String?
  vehicleRegistrationNumber String?
  insurancePolicyNumber     String?
  insuranceExpiry           DateTime?
  pucNumber                 String?
  pucExpiry                 DateTime?
  upiId                     String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  submittedAt               DateTime?
  reviewedAt                DateTime?
  remarks                   String?

  orders       Order[]
  bankAccounts RiderBankAccount[]
  settlements  RiderSettlement[]
  documents    RiderDocument[]
}

model RiderDocument {
  id                String                     @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner            @relation(fields: [deliveryPartnerId], references: [id])
  type              String // AADHAAR, DL_FRONT, DL_BACK, RC, INSURANCE, PUC, SELFIE, PROFILE_PHOTO
  filePath          String // legacy disk path for pre-serverless rows; new rows store the original filename here for display only
  fileData          Bytes? // file bytes, stored in Postgres instead of disk -- this is private KYC content that must not sit in public object storage
  mimeType          String?
  status            DocumentVerificationStatus @default(PENDING)
  remarks           String?
  uploadedAt        DateTime                   @default(now())
}

model RiderBankAccount {
  id                String          @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  isVerified        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model RiderSettlement {
  id                String           @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner  @relation(fields: [deliveryPartnerId], references: [id])
  amount            Float
  status            SettlementStatus @default(PENDING)
  transactionId     String?
  date              DateTime         @default(now())
}

model Address {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  title            String
  line1            String
  line2            String?
  city             String
  state            String
  pincode          String
  country          String?
  lat              Float?
  lng              Float?
  placeId          String?
  formattedAddress String?
  isDefault        Boolean          @default(false)
  orders           Order[]
  serviceBookings  ServiceBooking[]
}

// =======================
// VEHICLE MASTER DATA
// =======================

model Manufacturer {
  id       String      @id @default(uuid())
  name     String
  type     VehicleType @default(CAR)
  logo     String?
  models   Model[]
  vehicles Vehicle[]

  // Honda/BMW/Suzuki sell both cars and bikes, so a brand is one row per type
  @@unique([name, type])
}

model Model {
  id             String       @id @default(uuid())
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  name           String
  variants       Variant[]
  vehicles       Vehicle[]
}

model Variant {
  id       String    @id @default(uuid())
  modelId  String
  model    Model     @relation(fields: [modelId], references: [id])
  name     String
  vehicles Vehicle[]
}

model FuelType {
  id       String    @id @default(uuid())
  name     String    @unique // e.g., Petrol, Diesel, CNG, EV
  vehicles Vehicle[]
}

model Vehicle {
  id             String       @id @default(uuid())
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  modelId        String
  model          Model        @relation(fields: [modelId], references: [id])
  variantId      String?
  variant        Variant?     @relation(fields: [variantId], references: [id])
  fuelTypeId     String
  fuelType       FuelType     @relation(fields: [fuelTypeId], references: [id])
  year           Int
  engineCc       Int?

  userVehicles           UserVehicle[]
  productCompatibilities ProductCompatibility[]

  @@unique([manufacturerId, modelId, variantId, fuelTypeId, year])
}

// =======================
// CUSTOMER'S GARAGE
// =======================

model UserVehicle {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  // Manufacturer/Model/Variant taxonomy is now seeded (see prisma/seed-vehicle-master.ts),
  // but garage vehicles still snapshot brand/model/etc. as plain strings rather than a
  // required Vehicle FK, same shape as ServiceBooking's vehicleType/vehicleBrand/vehicleModel
  // snapshot fields -- keeps a garage entry valid even for combinations (e.g. a variant/year
  // pairing) the taxonomy doesn't have an exact Vehicle row for. vehicleId stays optional,
  // populated opportunistically when a matching row exists.
  vehicleId          String?
  vehicle            Vehicle?         @relation(fields: [vehicleId], references: [id])
  vehicleType        VehicleType
  brand              String
  model              String
  year               String?
  fuelType           String?
  engine             String?
  transmission       String?
  trim               String?
  registrationNumber String?
  nickname           String?
  isDefault          Boolean          @default(false)
  serviceBookings    ServiceBooking[]
}

// =======================
// PRODUCTS & CATALOG
// =======================

model Category {
  id          String      @id @default(uuid())
  name        String
  image       String?
  icon        String?     @default("📦")
  status      String?     @default("Active")
  vehicleType VehicleType @default(CAR)
  parentId    String?
  parent      Category?   @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryToCategory")
  products    Product[]

  @@unique([name, vehicleType])
}

model Brand {
  id          String      @id @default(uuid())
  name        String      @unique
  logo        String?
  vehicleType VehicleType @default(CAR)
  products    Product[]
}

model Product {
  id         String   @id @default(uuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])

  name              String
  description       String
  mrp               Float
  price             Float
  stock             Int                   @default(0)
  images            String[]
  oemNumber         String?
  partNumber        String?
  status            ProductApprovalStatus @default(APPROVED)
  vehicleType       VehicleType           @default(CAR)
  discountPrice     Float?
  b2bPrice          Float?
  lowStockThreshold Int                   @default(10)
  isFeatured        Boolean               @default(false)
  isDeal            Boolean               @default(false)
  salesCount        Int                   @default(0)
  compatibleModels  String?
  // Free-form key/value spec sheet (e.g. {"Viscosity":"10W-40","Volume":"3.5L"}),
  // shown on ProductDetailsScreen's Specifications tab. Nullable/optional --
  // most existing rows have none, and the product form doesn't require it.
  specifications    Json?
  // Denormalized from Review rows, kept in sync by
  // recomputeProductRating() (review.controller.ts) on every review
  // create/update/delete. Lets GET /products sort/filter by rating directly
  // in SQL instead of pulling every product's full review list into Node to
  // average client-side on every request.
  avgRating         Float                 @default(0)
  reviewCount       Int                   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compatibilities ProductCompatibility[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]
  inventories     Inventory[]
  stockTransfers  StockTransfer[]
  poItems         PurchaseOrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([avgRating])
}

model ProductCompatibility {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([productId, vehicleId])
}

// =======================
// ORDERS & PAYMENTS
// =======================

model Order {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  addressId         String
  address           Address          @relation(fields: [addressId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  couponId          String?
  coupon            Coupon?          @relation(fields: [couponId], references: [id])

  status         OrderStatus @default(PLACED)
  totalAmount    Float
  discountAmount Float       @default(0)
  deliveryFee    Float       @default(0)
  finalAmount    Float

  proofImageUrl String?
  codCollected  Boolean @default(false)
  issueReason   String?

  // Set when a rider calls "Generate OTP" once ON_THE_WAY; the customer reads
  // the code aloud and the rider enters it to confirm delivery. Cleared once
  // used. Mirrors ServiceBooking.completionOtp -- never returned to the
  // rider's own client, only to the order's owner.
  deliveryOtp            String?
  deliveryOtpGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([status])
  @@index([userId])
  @@index([deliveryPartnerId])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@index([productId])
}

model Payment {
  id                String          @id @default(uuid())
  // Exactly one of orderId/serviceBookingId is set per row -- enforced in
  // application code (order.controller.ts / service.controller.ts each create
  // Payment as a nested create under their own entity), not at the DB level.
  orderId           String?         @unique
  order             Order?          @relation(fields: [orderId], references: [id])
  serviceBookingId  String?         @unique
  serviceBooking    ServiceBooking? @relation(fields: [serviceBookingId], references: [id])
  method            PaymentMethod
  status            PaymentStatus
  transactionId     String?
  amount            Float
  // Razorpay gateway linkage -- unset for COD rows and for every payment made
  // before the gateway was integrated. See services/payment.service.ts.
  gatewayOrderId    String?
  gatewayPaymentId  String?
  razorpaySignature String?
  failureReason     String?
  createdAt         DateTime        @default(now())

  // Every webhook delivery and the client-side verify call look this row up
  // by gatewayOrderId (see controllers/payment.controller.ts) -- without an
  // index that's a full table scan on every payment event at any real volume.
  @@index([gatewayOrderId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  minOrderValue Float        @default(0)
  vehicleType   VehicleType? // null = applies to both CAR and BIKE orders
  isActive      Boolean      @default(true)
  orders        Order[]
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Event key (e.g. JOB_SEARCHING, JOB_ACCEPTED, JOB_START_OTP) so the app can
  // route a tap to the right screen and de-duplicate, instead of the previous
  // situation where every notification was an untyped title/body pair and
  // clients had to string-match the copy.
  type String?
  // Deep-link payload -- normally { bookingId }. Mirrors what goes out in the
  // Expo/FCM data field so an in-app notification behaves identically to a
  // push whether or not the push was delivered.
  data Json?

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([userId, type, createdAt])
}

enum EmailStatus {
  SKIPPED // RESEND_API_KEY not configured, or the recipient has no email on file
  SENT // Accepted by Resend; provider-side delivery outcome not yet known
  FAILED // Resend rejected the send (bad address, API error, etc.)
  DELIVERED // Confirmed by Resend's delivery webhook
  BOUNCED // Confirmed by Resend's bounce webhook
}

// One row per transactional email attempt -- the delivery-tracking/logging
// half of the email service (services/email.service.ts). `status` starts as
// SENT/FAILED/SKIPPED at send time and is updated to DELIVERED/BOUNCED later
// by the Resend webhook (routes/email.routes.ts), matched on
// providerMessageId. Deliberately not FK'd to Order/User -- template payloads
// vary (order confirmation today, others later) and this is an audit trail,
// not a relation other tables need to join through.
model EmailLog {
  id                String      @id @default(uuid())
  to                String
  subject           String
  template          String
  status            EmailStatus
  providerMessageId String?     @unique
  error             String?
  meta              Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([to, createdAt])
  @@index([status])
}

// Homepage newsletter signup -- no user account required (name matches
// common e-commerce UX: any visitor can subscribe with just an email).
model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

// =======================
// ADMIN & LOGS
// =======================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Banner {
  id           String      @id @default(uuid())
  title        String
  image        String
  type         BannerType  @default(HOMEPAGE)
  link         String?
  vehicleType  VehicleType @default(CAR)
  buttonText   String?
  redirectLink String?
  isActive     Boolean     @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SupportTicket {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id])
  subject     String
  description String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

// =======================
// INVENTORY & WAREHOUSE
// =======================

model Warehouse {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  address          String // legacy free-text, still authoritative for existing admin UI; kept as-is
  // Structured address, additive alongside `address` above -- see
  // prisma/backfill-warehouse-supplier-address.ts for the one-off copy of
  // existing `address` values into addressLine1.
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  pincode          String?
  country          String?
  lat              Float?
  lng              Float?
  placeId          String?
  formattedAddress String?
  managerName      String?
  phone            String?
  capacity         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventory     Inventory[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

model Supplier {
  id               String   @id @default(uuid())
  name             String
  companyName      String
  contactPerson    String?
  phone            String?
  email            String?
  gstNumber        String?
  address          String? // legacy free-text, kept as-is -- see Warehouse.address
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  pincode          String?
  country          String?
  lat              Float?
  lng              Float?
  placeId          String?
  formattedAddress String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model Inventory {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  batchNumber    String?
  availableStock Int     @default(0)
  reservedStock  Int     @default(0)
  damagedStock   Int     @default(0)
  reorderLevel   Int     @default(0)
  unitCost       Float   @default(0)

  mfgDate    DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])

  action       StockMovementAction
  prevQuantity Int
  newQuantity  Int
  quantityDiff Int // Can be negative or positive
  reason       String?

  createdAt DateTime @default(now())
}

model StockTransfer {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  quantity     Int
  status       StockTransferStatus @default(PENDING)
  transferDate DateTime?
  receivedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)

  totalCost    Float     @default(0)
  taxAmount    Float     @default(0)
  expectedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])

  quantity    Int
  unitCost    Float
  taxAmount   Float @default(0)
  receivedQty Int   @default(0)
}

model Offer {
  id            String       @id @default(uuid())
  title         String
  description   String?
  image         String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  code          String?      @unique
  vehicleType   VehicleType  @default(CAR)
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// =======================
// DOORSTEP SERVICES
// =======================

model ServiceTechnician {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  specializations VehicleType[]
  isActive        Boolean       @default(false)
  isOnline        Boolean       @default(false)
  currentLat      Float?
  currentLng      Float?
  // Freshness guard for dispatch. A mechanic whose last ping is older than
  // DISPATCH_STALE_LOCATION_SECONDS is treated as unreachable and skipped by
  // the candidate query, so a phone that died three hours ago while "online"
  // can't absorb an emergency offer and let it expire.
  lastLocationAt  DateTime?
  lastHeadingDeg  Float?
  lastSpeedMps    Float?
  expoPushToken   String?
  walletBalance   Float         @default(0.0)
  rating          Float         @default(0)
  totalJobs       Int           @default(0)

  // KYC / registration & verification -- mirrors DeliveryPartner exactly.
  status                TechnicianStatus @default(PENDING)
  addressLine           String?
  city                  String?
  state                 String?
  pincode               String?
  // Geocoded KYC address -- see DeliveryPartner's identical block for why
  // this is additive-only rather than restructuring addressLine.
  lat                   Float?
  lng                   Float?
  placeId               String?
  formattedAddress      String?
  country               String?
  aadhaarNumber         String?
  skills                String[]
  experienceYears       Int?
  emergencyContactName  String?
  emergencyContactPhone String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  remarks               String?

  bookings       ServiceBooking[]
  documents      TechnicianDocument[]
  bankAccounts   TechnicianBankAccount[]
  settlements    TechnicianSettlement[]
  reviews        ServiceReview[]
  dispatchOffers JobDispatchOffer[]
  locationPings  JobLocationPing[]

  // Hot path: the dispatch candidate query filters on exactly these columns.
  @@index([isOnline, isActive, status])
  @@index([lastLocationAt])
}

model TechnicianDocument {
  id           String                     @id @default(uuid())
  technicianId String
  technician   ServiceTechnician          @relation(fields: [technicianId], references: [id])
  type         String // AADHAAR, CERTIFICATION, SELFIE, PROFILE_PHOTO
  filePath     String // original filename, display only -- bytes are the source of truth
  fileData     Bytes? // stored in Postgres, not disk -- see RiderDocument for rationale (private KYC content)
  mimeType     String?
  status       DocumentVerificationStatus @default(PENDING)
  remarks      String?
  uploadedAt   DateTime                   @default(now())
}

model TechnicianBankAccount {
  id                String            @id @default(uuid())
  technicianId      String
  technician        ServiceTechnician @relation(fields: [technicianId], references: [id])
  accountHolderName String
  bankName          String
  accountNumber     String
  ifscCode          String
  isVerified        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model TechnicianSettlement {
  id            String            @id @default(uuid())
  technicianId  String
  technician    ServiceTechnician @relation(fields: [technicianId], references: [id])
  amount        Float
  status        SettlementStatus  @default(PENDING)
  transactionId String?
  date          DateTime          @default(now())
}

model ServiceCategory {
  id          String      @id @default(uuid())
  name        String
  icon        String?     @default("🔧")
  image       String?
  description String?
  vehicleType VehicleType @default(CAR)
  isEmergency Boolean     @default(false)
  status      String      @default("Active")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  packages ServicePackage[]
  bookings ServiceBooking[]

  @@unique([name, vehicleType])
}

model ServicePackage {
  id               String          @id @default(uuid())
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  name             String
  description      String?
  image            String?
  price            Float
  discountPrice    Float?
  estimatedMinutes Int             @default(60)
  includedServices String[]
  isActive         Boolean         @default(true)
  isPopular        Boolean         @default(false)
  isRecommended    Boolean         @default(false)
  isEmergency      Boolean         @default(false)
  rating           Float           @default(0)
  reviewCount      Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  bookings ServiceBooking[]
}

model TimeSlot {
  id                 String  @id @default(uuid())
  label              String // e.g. "9:00 AM - 11:00 AM"
  startTime          String // "09:00"
  endTime            String // "11:00"
  maxBookingsPerSlot Int     @default(20)
  isActive           Boolean @default(true)
  sortOrder          Int     @default(0)

  bookings ServiceBooking[]
}

model ServiceBooking {
  id            String @id @default(uuid())
  bookingNumber String @unique

  userId                    String
  user                      User         @relation(fields: [userId], references: [id])
  // The mobile "Garage" (UserVehicle) is currently a client-side/AsyncStorage-only
  // feature with no backend API writing to UserVehicle, and the Manufacturer/Model
  // master-data tables have no CAR/BIKE column and are unseeded -- so vehicle
  // details are snapshotted directly on the booking (like Order/OrderItem
  // snapshot price at order time) rather than hard-required via FK. userVehicleId
  // stays optional so a future Garage-sync API (Phase 2) can link back to it.
  userVehicleId             String?
  userVehicle               UserVehicle? @relation(fields: [userVehicleId], references: [id])
  vehicleType               VehicleType
  vehicleBrand              String
  vehicleModel              String
  vehicleFuelType           String?
  vehicleRegistrationNumber String?

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  packageId  String
  package    ServicePackage  @relation(fields: [packageId], references: [id])

  technicianId String?
  technician   ServiceTechnician? @relation(fields: [technicianId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  // Nullable as of the emergency-dispatch workflow. An emergency job is an
  // instant dispatch -- there is no appointment date and no slot to reserve,
  // and forcing a synthetic "today / first slot" value would corrupt slot
  // capacity accounting for the scheduled bookings that genuinely use it.
  // Scheduled (non-emergency) bookings still require both; that requirement
  // now lives in createBooking rather than in the column type.
  scheduledDate DateTime?
  timeSlotId    String?
  timeSlot      TimeSlot? @relation(fields: [timeSlotId], references: [id])

  // Emergency breakdown job: dispatched instantly to nearby mechanics instead
  // of being placed into a slot. Drives which validation path createBooking
  // takes and which screens the customer app renders.
  isEmergency Boolean @default(false)

  // Exact breakdown pin, snapshotted at request time. Deliberately NOT read
  // through the Address relation at display time: a saved address can be
  // edited or deleted afterwards, and a roadside breakdown is frequently not
  // at any saved address at all. Falls back to the address centroid when the
  // customer did not drop a precise pin.
  jobLat         Float?
  jobLng         Float?
  jobAddressText String?
  landmark       String?
  customerNotes  String?

  issueDescription String?
  status           BookingStatus @default(PENDING)

  estimatedCost  Float
  additionalCost Float @default(0)
  finalAmount    Float

  approvalStatus String? // PENDING, APPROVED, REJECTED -- a non-blocking flag for
  // an in-flight additional-work-cost request while status stays WORK_STARTED; not
  // a booking status itself (see BookingStatus.REJECTED, which is a technician
  // declining the job, an unrelated concept despite the similar string).
  approvalNote   String?

  cancelReason String?
  completedAt  DateTime?

  // ---- Dispatch state (emergency jobs) ----
  // Which fan-out wave we are on. Wave N searches a larger radius than N-1;
  // see dispatch.service.ts DISPATCH_WAVES.
  dispatchWave      Int       @default(0)
  dispatchStartedAt DateTime?
  dispatchEndedAt   DateTime?
  // Radius the winning offer was made at -- kept for ops analytics ("how far
  // are we having to reach to fill jobs in this area at this hour").
  dispatchRadiusKm  Float?

  // ---- Timeline timestamps ----
  // Each one is written exactly once, inside the same transaction as the
  // status transition that produces it, so the timeline can never disagree
  // with `status`. BookingStatusHistory remains the append-only audit trail;
  // these denormalized columns exist so the common "show me the timeline for
  // one job" render doesn't need a join, and so admin analytics can aggregate
  // durations without walking history rows.
  acceptedAt              DateTime?
  enRouteAt               DateTime?
  arrivedAt               DateTime?
  startedAt               DateTime?
  startOtpVerifiedAt      DateTime?
  completionOtpVerifiedAt DateTime?
  paymentCompletedAt      DateTime?
  ratedAt                 DateTime?

  // Set true only by a successful START OTP verification. This is the
  // "customer was physically present and consented to work beginning" flag --
  // an admin force-transitioning a stuck job to WORK_STARTED deliberately does
  // NOT set it, so a disputed job can be told apart from a verified one.
  verifiedByCustomer Boolean @default(false)

  // ---- Live tracking rollups ----
  // Maintained incrementally by the location ingestion path so neither the
  // customer's ETA card nor the admin live map has to scan JobLocationPing.
  distanceTravelledKm Float     @default(0)
  etaSeconds          Int?
  distanceRemainingM  Int?
  etaUpdatedAt        DateTime?
  // Encoded Google polyline for the current mechanic->customer route. Refreshed
  // at most once per ETA_ROUTE_REFRESH_SECONDS, not per ping.
  routePolyline       String?

  // Legacy plaintext completion OTP from the pre-dispatch scheduled-booking
  // flow. Superseded by JobOtp (encrypted at rest, attempt-limited, expiring).
  // Retained only so in-flight bookings created before this migration can still
  // be completed; no new code path writes it.
  completionOtp            String?
  completionOtpGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ServiceImage[]
  statusHistory  BookingStatusHistory[]
  messages       ServiceChatMessage[]
  payment        Payment?
  review         ServiceReview?
  invoice        ServiceInvoice?
  dispatchOffers JobDispatchOffer[]
  locationPings  JobLocationPing[]
  otps           JobOtp[]
  callSessions   CallSession[]

  @@index([userId])
  @@index([technicianId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledDate])
  // Admin live-ops board and the dispatch sweeper both scan "emergency jobs
  // currently in a non-terminal state, newest first".
  @@index([isEmergency, status, createdAt])
  // Sweeper: "jobs still SEARCHING whose current wave may have timed out".
  @@index([status, dispatchStartedAt])
}

// =======================
// EMERGENCY DISPATCH
// =======================

// One row per (job, mechanic) offer. The dispatch engine writes a batch of
// these per wave; the mechanic app reads its own OFFERED rows; the expiry
// sweeper closes out the ones nobody answered.
model JobDispatchOffer {
  id           String            @id @default(uuid())
  bookingId    String
  booking      ServiceBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technicianId String
  technician   ServiceTechnician @relation(fields: [technicianId], references: [id])

  wave   Int                 @default(1)
  status DispatchOfferStatus @default(OFFERED)

  // Snapshot of the mechanic's position relative to the job at offer time --
  // what the mechanic app shows on the offer card, and what ops uses to audit
  // why a given mechanic was chosen. Not recomputed later.
  distanceKm Float?
  etaSeconds Int?

  offeredAt     DateTime  @default(now())
  expiresAt     DateTime
  respondedAt   DateTime?
  declineReason String?

  // Which delivery channels actually fired for this offer (SOCKET, EXPO_PUSH,
  // FCM). A mechanic who was offered a job on zero live channels is a
  // deliverability incident, not a slow mechanic -- ops needs to tell them
  // apart.
  notifiedVia String[] @default([])

  // A mechanic is offered a given job at most once, ever. Also makes the
  // per-wave insert idempotent: a retried wave can use skipDuplicates instead
  // of re-offering a job someone already declined.
  @@unique([bookingId, technicianId])
  // Mechanic app: "my open offers".
  @@index([technicianId, status])
  // Expiry sweeper: "offers past their deadline that are still open".
  @@index([status, expiresAt])
  @@index([bookingId, status])
}

// Start and completion OTPs for a job. Replaces ServiceBooking.completionOtp:
// codes are encrypted at rest, single-use, expiring, and attempt-limited.
model JobOtp {
  id        String         @id @default(uuid())
  bookingId String
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  purpose   JobOtpPurpose

  // AES-256-GCM ciphertext of the 6-digit code (iv:tag:ciphertext, base64).
  // Reversible rather than hashed because the customer has to be able to SEE
  // their own code in-app -- a one-way hash would make the feature impossible.
  // The key never leaves the server and the plaintext is only ever decrypted
  // into a response addressed to the job's own customer.
  codeEnc String

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  // Single-use: set on the first successful verification. A consumed row is
  // never matched again, so a replayed request cannot re-run the transition.
  consumedAt  DateTime?

  createdAt       DateTime @default(now())
  createdByUserId String?

  // Only the newest unconsumed row per (booking, purpose) is live; older rows
  // are kept for the audit trail rather than deleted.
  @@index([bookingId, purpose, consumedAt])
  @@index([expiresAt])
}

// Raw GPS breadcrumb trail. High-write, append-only, and pruned by retention
// sweep once a job has been settled -- ServiceBooking.distanceTravelledKm and
// the route polyline are the durable derivatives.
model JobLocationPing {
  // autoincrement rather than uuid: this is the hottest insert path in the
  // system (one row per mechanic per ~4s per active job) and a monotonic key
  // keeps the btree appends sequential instead of scattering them.
  id           Int               @id @default(autoincrement())
  bookingId    String
  booking      ServiceBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technicianId String
  technician   ServiceTechnician @relation(fields: [technicianId], references: [id])

  lat        Float
  lng        Float
  accuracyM  Float?
  headingDeg Float?
  speedMps   Float?
  batteryPct Int?

  // Device clock at capture time. Distinct from receivedAt because the app
  // buffers pings while offline and flushes them in a batch on reconnect --
  // ordering must follow the device's own capture order, not arrival order.
  recordedAt DateTime
  receivedAt DateTime @default(now())

  @@index([bookingId, recordedAt])
  @@index([technicianId, recordedAt])
}

// Audit record for every masked call attempt. Also the enforcement point for
// "calls are only possible between acceptance and completion" -- there is no
// code path that reveals a raw phone number without writing one of these.
model CallSession {
  id        String         @id @default(uuid())
  bookingId String
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  initiatedByUserId String
  fromRole          String // CUSTOMER | TECHNICIAN
  provider          String // EXOTEL | DIRECT_FALLBACK
  providerCallSid   String?
  // The number the caller's handset actually dials. Never a participant's real
  // number when a masking provider is configured.
  virtualNumber     String?
  status            String    @default("INITIATED") // INITIATED | RINGING | ANSWERED | COMPLETED | FAILED
  failureReason     String?
  durationSec       Int?
  createdAt         DateTime  @default(now())
  endedAt           DateTime?

  @@index([bookingId, createdAt])
}

model BookingStatusHistory {
  id              String         @id @default(uuid())
  bookingId       String
  booking         ServiceBooking @relation(fields: [bookingId], references: [id])
  status          BookingStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime       @default(now())
}

model ServiceChatMessage {
  id           String         @id @default(uuid())
  bookingId    String
  booking      ServiceBooking @relation(fields: [bookingId], references: [id])
  senderUserId String
  senderRole   String // CUSTOMER, TECHNICIAN
  message      String
  createdAt    DateTime       @default(now())

  @@index([bookingId])
}

model ServiceImage {
  id             String         @id @default(uuid())
  bookingId      String
  booking        ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fileData       Bytes?
  mimeType       String?
  type           String // ISSUE, BEFORE, DURING, AFTER, ADDITIONAL_WORK, FEEDBACK
  uploadedByRole String // CUSTOMER, TECHNICIAN
  createdAt      DateTime       @default(now())

  // Provenance, required by the work-progress spec: every work photo must be
  // attributable to a person, a moment and (where the device allowed it) a
  // place. uploadedByUserId is the User id behind uploadedByRole -- the role
  // alone can't identify which mechanic uploaded it after a reassignment.
  uploadedByUserId String?
  capturedAt       DateTime?
  lat              Float?
  lng              Float?
  // Content hash + size: dedupes an app retrying the same upload after a
  // network drop, and lets a disputed photo be proven unmodified since upload.
  sha256           String?
  sizeBytes        Int?

  @@index([bookingId, type])
  @@index([bookingId, sha256])
}

model ServiceReview {
  id           String            @id @default(uuid())
  bookingId    String            @unique
  booking      ServiceBooking    @relation(fields: [bookingId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  technicianId String
  technician   ServiceTechnician @relation(fields: [technicianId], references: [id])
  rating       Int
  comment      String?
  createdAt    DateTime          @default(now())

  // Optional feedback photo. Stored inline as bytes for the same reason
  // ServiceImage does (private content, never a publicly reachable URL).
  imageData     Bytes?
  imageMimeType String?

  @@index([technicianId])
}

model ServiceInvoice {
  id             String         @id @default(uuid())
  bookingId      String         @unique
  booking        ServiceBooking @relation(fields: [bookingId], references: [id])
  invoiceNumber  String         @unique
  subtotal       Float
  additionalCost Float          @default(0)
  discountAmount Float          @default(0)
  taxAmount      Float          @default(0)
  totalAmount    Float
  pdfUrl         String?
  createdAt      DateTime       @default(now())
}
