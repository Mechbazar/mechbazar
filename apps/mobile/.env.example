# Copy to .env and adjust if needed. Both vars are optional in dev --
# apps/mobile/src/services/api.ts auto-detects the backend host from the
# Expo dev server's own LAN address, so a phone on the same Wi-Fi as your
# dev machine needs no configuration at all.

# Overrides the auto-detected host entirely. Required for production builds
# (EAS) and any build not on the same LAN as the backend.
# EXPO_PUBLIC_API_URL=https://mechbazar-backend.vercel.app/api

# Port the backend listens on when auto-detecting the LAN host. Must match
# apps/backend/.env's PORT.
EXPO_PUBLIC_BACKEND_PORT=5001

# Phone login always uses Firebase Phone Auth (src/services/phoneAuth.ts /
# phoneAuth.web.ts) -- there is no TEST/raw-OTP mode or provider flag anymore.
# The Firebase web config lives in src/services/firebase.ts.

# Web push only (src/services/webPush.ts). From Firebase Console -> Project
# Settings -> Cloud Messaging -> Web configuration -> Web Push certificates.
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Google Maps integration point (src/config/maps.ts) -- address picker,
# vendor/store locator, delivery tracking, and mechanic service-area picker
# all render an honest MapPlaceholder ("coming soon") until this is set.
# Restrict the key to Maps JavaScript API + Places API, and by HTTP referrer
# (web) / package name + SHA-1 (native), before using it -- it ships in the
# client bundle either way.
#
# MUST be a Google *Maps Platform* key: "AIza" + 35 characters. src/config/maps.ts
# and app.config.js both shape-check it and fall back to the placeholder if it
# doesn't match, because a credential from another Google product (an AI Studio
# / Generative Language key starting "AQ.") was once pasted here -- it passed the
# old non-empty check, so the app mounted a real map that Google then refused
# (REQUEST_DENIED / InvalidKeyMapError) and users got a dead grey box.
#
# This gates map *rendering* only. Address search, reverse geocoding and place
# details proxy through the backend's GOOGLE_MAPS_SERVER_API_KEY, so the
# "Add Address" flow works in full (search + GPS + manual entry) without this.
#
# Web and native need DIFFERENT keys: an HTTP-referrer-restricted key cannot be
# used by the Android/iOS Maps SDK. For EAS builds set the native key under
# build.<profile>.env in eas.json -- .env is gitignored and is NOT uploaded to
# EAS, so a key present only here will be absent from every APK/IPA.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
