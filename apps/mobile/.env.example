# Copy to .env and adjust if needed. Both vars are optional in dev --
# apps/mobile/src/services/api.ts auto-detects the backend host from the
# Expo dev server's own LAN address, so a phone on the same Wi-Fi as your
# dev machine needs no configuration at all.

# Overrides the auto-detected host entirely. Required for production builds
# and any build not on the same LAN as the backend. The backend is served
# from the Hostinger VPS behind nginx, which proxies /api/ (and /uploads/,
# /socket.io/) to it -- see deploy/nginx/mechbazar.
# EXPO_PUBLIC_API_URL=https://mechbazar.com/api

# Port the backend listens on when auto-detecting the LAN host. Must match
# apps/backend/.env's PORT.
EXPO_PUBLIC_BACKEND_PORT=5001

# Phone login always uses Firebase Phone Auth (src/services/phoneAuth.ts /
# phoneAuth.web.ts) -- there is no TEST/raw-OTP mode or provider flag anymore.
# The Firebase web config lives in src/services/firebase.ts.

# Web push only (src/services/webPush.ts). From Firebase Console -> Project
# Settings -> Cloud Messaging -> Web configuration -> Web Push certificates.
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Google Maps integration point (src/config/maps.ts) -- address picker,
# vendor/store locator, delivery tracking, and mechanic service-area picker
# all render an honest MapPlaceholder ("coming soon") until the relevant key
# below is set. MUST be a Google *Maps Platform* key: "AIza" + 35 characters.
# src/config/maps.ts and app.config.js both shape-check it and fall back to
# the placeholder if it doesn't match, because a credential from another
# Google product (an AI Studio / Generative Language key starting "AQ.") was
# once pasted here -- it passed the old non-empty check, so the app mounted a
# real map that Google then refused (REQUEST_DENIED / InvalidKeyMapError) and
# users got a dead grey box instead of the placeholder.
#
# This gates map *rendering* only. Address search, reverse geocoding and place
# details proxy through the backend's GOOGLE_MAPS_SERVER_API_KEY, so the
# "Add Address" flow works in full (search + GPS + manual entry) without either.
#
# TWO SEPARATE KEYS -- an HTTP-referrer-restricted key cannot be used by the
# Android/iOS Maps SDK (there is no HTTP referrer on-device), so web and native
# need different, independently-restricted credentials:

# 1. Web only. Restrict to Maps JavaScript API + Places API, by HTTP referrer,
#    in Google Cloud Console. Used by the Docker web build (docker-compose.yml
#    build arg, sourced from the root .env) and *.web.tsx map components.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# 2. Native only (Android/iOS, i.e. every EAS build). Restrict to Maps SDK for
#    Android + Maps SDK for iOS + Places API, by Android package name
#    (com.mechbazar.mobile) + SHA-1 / iOS bundle ID, in Google Cloud Console.
#    Baked into app.config.js's android.config.googleMaps.apiKey /
#    ios.config.googleMapsApiKey, and gates AddressMapPicker.tsx /
#    LiveTrackingMap.tsx (the non-.web.tsx map components) via MAPS_ENABLED_NATIVE.
#
#    NOT read from this file for EAS builds: EAS Build packages the repo
#    respecting .gitignore, and .env is gitignored, so a value here never
#    reaches `eas build`. Set it as an EAS environment variable instead, once
#    per environment:
#      eas env:create --scope project --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_NATIVE \
#        --value "<key>" --environment development
#      (repeat --environment preview, --environment production)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_NATIVE=
