{
  "expo": {
    "name": "MechBazar Admin",
    "slug": "mechbazar-admin",
    "owner": "mechbazar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mechbazar.admin"
    },
    "android": {
      "package": "com.mechbazar.admin",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A1230",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "MechBazar Admin accesses your photo library so you can pick images for banners and service packages.",
          "cameraPermission": "MechBazar Admin uses your camera so you can photograph and attach images for banners and service packages."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2F5BFF",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-dark.png",
          "imageWidth": 176,
          "resizeMode": "contain",
          "backgroundColor": "#0A1230",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0A1230"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7e35fa7f-ac3e-4ab9-8238-5aa1205b6718"
      }
    }
  }
}
