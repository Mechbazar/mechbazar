server {
    server_name mechbazar.com www.mechbazar.com;

    location /api/ {
        # Nginx's default (1m) is below multer's 5MB per-file limit
        # (apps/backend/src/middlewares/upload.ts), so KYC document/image
        # uploads were rejected here with a bare 413 before ever reaching the
        # backend -- a response with no Access-Control-Allow-Origin header
        # (only the Express app's cors() middleware adds that), which the
        # browser then misreports as a CORS failure instead of a size limit.
        client_max_body_size 10m;

        proxy_pass http://127.0.0.1:5005;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:5005;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        # The emergency-dispatch realtime gateway (apps/backend/src/realtime/gateway.ts)
        # mounts Socket.IO at the default '/socket.io' path on the backend's own HTTP
        # server (port 5005), not under /api/. Without this block, socket handshakes
        # fall through to the `location /` catch-all below and hit the Customer App
        # static container (3002) instead of the backend -- every realtime feature
        # (dispatch offers, live tracking, OTP-issued events, admin live-ops board)
        # silently fails with no error surfaced to the client beyond a failed upgrade.
        proxy_pass http://127.0.0.1:5005;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Websockets are long-lived; Nginx's default 60s proxy_read_timeout would
        # silently drop idle-but-open dispatch/tracking connections.
        proxy_read_timeout 86400s;
    }

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mechbazar.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mechbazar.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = www.mechbazar.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = mechbazar.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name mechbazar.com www.mechbazar.com;
    return 404; # managed by Certbot
}
