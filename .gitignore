# Dependencies
node_modules/

# Build outputs
dist/
build/
.expo/
*.tsbuildinfo

# Environment files — never commit real env values (examples are allowed)
.env
.env.*
!.env.example

# Native build outputs & signing keys
android/
ios/
*.keystore
*.jks
# Local signing credentials for `eas build --local`: holds the keystore and
# key passwords in plaintext, so it must never be committed. See
# docs/LOCAL_BUILDS.md for how to regenerate it from EAS.
credentials.json

# Runtime data — user uploads & KYC documents must never be committed
uploads/
private-uploads/

# Secrets
firebaseServiceAccount.json
# Firebase Admin SDK service-account keys carry a full-privilege private key.
# The console downloads them as "<project>-firebase-adminsdk-<hash>.json", which
# the line above does not match -- one was sitting untracked in the repo root.
*-firebase-adminsdk-*.json

# Logs & local artifacts
*.log
*.log.err
*.orig.*
.DS_Store
qr-codes/
MECHBAZAR/
