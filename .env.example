# Repo-root .env, read by `docker compose` for variable substitution in
# docker-compose.yml (Docker Compose auto-loads a `.env` file next to the
# compose file). Copy this to `.env` (gitignored) and fill in real values
# before running `docker compose up -d --build` on the VPS.
#
# This is separate from apps/mobile/.env, which is used for local Expo dev
# only and is NOT read by Docker Compose.

# Google Maps Platform key baked into the apps/mobile web build at build time.
# Restrict it in Google Cloud Console to Maps JavaScript API + Places API +
# Geocoding API, scoped by HTTP referrer (mechbazar.com, *.mechbazar.com).
# Rotate this value if it is ever exposed (e.g. committed to git) -- an
# exposed key must be treated as compromised even after removal from source,
# since it remains in git history.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Same key as above (or a separate one restricted to vendor.mechbazar.com /
# whatever domain apps/vendor is served from) baked into the vendor web
# build's store-location picker (Register.tsx business step, Profile.tsx).
VITE_GOOGLE_MAPS_API_KEY=
